---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Chanales Flores | Software Development Engineer',
	description = 'Chanales Flores is a Software Development Engineer 2 building scalable software solutions.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/hero-favicon.png" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<script is:inline>
			(() => {
				const themeKey = 'chanales-theme';
				const legacyThemeKey = 'alex-theme';

				try {
					let savedTheme = localStorage.getItem(themeKey);
					const legacyTheme = localStorage.getItem(legacyThemeKey);

					if (legacyTheme === 'dark' || legacyTheme === 'light') {
						if (!savedTheme) {
							savedTheme = legacyTheme;
							localStorage.setItem(themeKey, legacyTheme);
						}
						localStorage.removeItem(legacyThemeKey);
					}

					if (savedTheme === 'dark' || savedTheme === 'light') {
						document.documentElement.dataset.theme = savedTheme;
					}
				} catch {
					// Keep the default dark theme when storage is unavailable.
				}
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
