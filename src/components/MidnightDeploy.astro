---
import { RotateCcw, X } from '@lucide/astro';
---

<div class="midnight-deploy" data-midnight-deploy>
	<div class="game-panel" role="region" aria-labelledby="midnight-deploy-title" aria-describedby="midnight-deploy-help">
		<div class="game-shell">
			<header class="game-header">
				<div>
					<p class="game-kicker">// after hours</p>
					<h2 id="midnight-deploy-title">Midnight Deploy</h2>
				</div>
				<button class="close-icon" type="button" aria-label="Close Midnight Deploy" title="Close" data-game-close>
					<X size={20} stroke-width="1.7" aria-hidden="true" />
				</button>
			</header>

			<div class="game-hud" aria-label="Game status">
				<span>TIME <strong data-game-time>00:00.0</strong></span>
				<span>TOKENS <strong data-game-progress>0 / 4</strong></span>
				<span class="terminal-state" data-terminal-state>TERMINAL LOCKED</span>
			</div>

			<div class="game-stage">
				<canvas width="960" height="540" role="img" aria-label="Midnight Deploy pixel-art platform game" data-game-canvas>
					Your browser does not support the canvas element required to play Midnight Deploy.
				</canvas>

				<div class="game-overlay start-screen" data-start-screen>
					<div class="overlay-card">
						<p class="overlay-eyebrow">DEPLOY WINDOW OPEN</p>
						<h3>Ship before sunrise.</h3>
						<p>Collect <strong>PLAN</strong>, <strong>CODE</strong>, <strong>BUILD</strong>, and <strong>REPEAT</strong>. Dodge the bugs, then reach the terminal.</p>
						<button class="primary-control" type="button" data-game-start>Start game</button>
					</div>
				</div>

				<div class="game-overlay win-screen" hidden data-win-screen>
					<div class="overlay-card">
						<p class="overlay-eyebrow">DEPLOYMENT COMPLETE</p>
						<h3>It works on production.</h3>
						<p>All four tokens delivered in <strong data-final-time>00:00.0</strong>.</p>
						<div class="overlay-actions">
							<button class="primary-control" type="button" data-win-restart>Play again</button>
							<button class="secondary-control" type="button" data-win-close>Close</button>
						</div>
					</div>
				</div>
			</div>

			<p class="game-help" id="midnight-deploy-help">
				<span><kbd>A</kbd><kbd>D</kbd> or <kbd>←</kbd><kbd>→</kbd> move</span>
				<span><kbd>W</kbd>, <kbd>↑</kbd>, or <kbd>Space</kbd> jump</span>
			</p>

			<div class="touch-controls" aria-label="Touch controls" data-touch-controls>
				<div class="touch-directions">
					<button type="button" aria-label="Move left" data-control="left">←</button>
					<button type="button" aria-label="Move right" data-control="right">→</button>
				</div>
				<button class="jump-control" type="button" aria-label="Jump" data-control="jump">↑ <span>JUMP</span></button>
			</div>

			<footer class="game-footer">
				<span aria-live="polite" data-game-message>Press Start game when you are ready.</span>
				<div>
					<button class="text-control" type="button" data-game-restart><RotateCcw size={14} stroke-width="1.8" aria-hidden="true" /> Restart</button>
					<button class="text-control" type="button" data-game-close>Close</button>
				</div>
			</footer>
		</div>
	</div>
</div>

<script>
	type Rectangle = { x: number; y: number; w: number; h: number };
	type Platform = Rectangle & { accent?: boolean };
	type Token = Rectangle & { label: string; collected: boolean; color: string };
	type Bug = Rectangle & { minX: number; maxX: number; speed: number; direction: number };

	const roots = document.querySelectorAll<HTMLElement>('[data-midnight-deploy]');

	for (const root of roots) {
		if (root.dataset.ready === 'true') continue;
		root.dataset.ready = 'true';

		const host = root.closest<HTMLElement>('[data-game-host]');
		const gameView = host?.querySelector<HTMLElement>('[data-game-view]');
		const heroContent = host?.querySelector<HTMLElement>('[data-hero-content]');
		const openButton = host?.querySelector<HTMLButtonElement>('[data-game-open]');
		const canvas = root.querySelector<HTMLCanvasElement>('[data-game-canvas]');
		const startScreen = root.querySelector<HTMLElement>('[data-start-screen]');
		const winScreen = root.querySelector<HTMLElement>('[data-win-screen]');
		const startButton = root.querySelector<HTMLButtonElement>('[data-game-start]');
		const restartButtons = root.querySelectorAll<HTMLButtonElement>('[data-game-restart], [data-win-restart]');
		const closeButtons = root.querySelectorAll<HTMLButtonElement>('[data-game-close], [data-win-close]');
		const timeDisplay = root.querySelector<HTMLElement>('[data-game-time]');
		const finalTimeDisplay = root.querySelector<HTMLElement>('[data-final-time]');
		const progressDisplay = root.querySelector<HTMLElement>('[data-game-progress]');
		const terminalDisplay = root.querySelector<HTMLElement>('[data-terminal-state]');
		const messageDisplay = root.querySelector<HTMLElement>('[data-game-message]');
		const context = canvas?.getContext('2d');

		if (!host || !gameView || !heroContent || !openButton || !canvas || !context || !startScreen || !winScreen || !startButton) continue;

		const WIDTH = 960;
		const HEIGHT = 540;
		const TOTAL_TOKENS = 4;
		const spawn = { x: 45, y: 452 };
		const player = { x: spawn.x, y: spawn.y, w: 22, h: 40, vx: 0, vy: 0, grounded: false };
		const terminal: Rectangle = { x: 887, y: 408, w: 48, h: 62 };
		const platforms: Platform[] = [
			{ x: 0, y: 492, w: 185, h: 48 },
			{ x: 215, y: 446, w: 150, h: 20, accent: true },
			{ x: 397, y: 382, w: 124, h: 20, accent: true },
			{ x: 548, y: 446, w: 157, h: 20, accent: true },
			{ x: 737, y: 362, w: 105, h: 20, accent: true },
			{ x: 865, y: 470, w: 95, h: 70 },
		];
		const tokens: Token[] = [
			{ x: 260, y: 407, w: 59, h: 24, label: 'PLAN', color: '#72d9ff', collected: false },
			{ x: 430, y: 343, w: 59, h: 24, label: 'CODE', color: '#5cf0b5', collected: false },
			{ x: 592, y: 407, w: 64, h: 24, label: 'BUILD', color: '#ffd166', collected: false },
			{ x: 755, y: 323, w: 70, h: 24, label: 'REPEAT', color: '#a78bfa', collected: false },
		];
		const bugs: Bug[] = [
			{ x: 242, y: 429, w: 24, h: 17, minX: 224, maxX: 332, speed: 62, direction: 1 },
			{ x: 648, y: 429, w: 24, h: 17, minX: 558, maxX: 672, speed: 76, direction: -1 },
		];
		const input = { left: false, right: false, jump: false, jumpQueued: false };
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let isOpen = false;
		let started = false;
		let won = false;
		let elapsed = 0;
		let lastFrame = 0;
		let animationFrame = 0;
		let respawnGlow = 0;

		const intersects = (a: Rectangle, b: Rectangle) =>
			a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;

		const formatTime = (seconds: number) => {
			const minutes = Math.floor(seconds / 60).toString().padStart(2, '0');
			const remaining = (seconds % 60).toFixed(1).padStart(4, '0');
			return `${minutes}:${remaining}`;
		};

		const collectedCount = () => tokens.filter((token) => token.collected).length;

		const updateHud = () => {
			if (timeDisplay) timeDisplay.textContent = formatTime(elapsed);
			if (progressDisplay) progressDisplay.textContent = `${collectedCount()} / ${TOTAL_TOKENS}`;
			const unlocked = collectedCount() === TOTAL_TOKENS;
			if (terminalDisplay) {
				terminalDisplay.textContent = unlocked ? 'TERMINAL READY' : 'TERMINAL LOCKED';
				terminalDisplay.classList.toggle('is-ready', unlocked);
			}
		};

		const clearInput = () => {
			input.left = false;
			input.right = false;
			input.jump = false;
			input.jumpQueued = false;
		};

		const resetPlayer = (announce = true) => {
			player.x = spawn.x;
			player.y = spawn.y;
			player.vx = 0;
			player.vy = 0;
			player.grounded = false;
			respawnGlow = reducedMotion.matches ? 0 : 0.55;
			clearInput();
			if (announce && messageDisplay) messageDisplay.textContent = 'Bug found. Respawning — collected tokens kept.';
		};

		const resetGame = () => {
			cancelAnimationFrame(animationFrame);
			animationFrame = 0;
			started = false;
			won = false;
			elapsed = 0;
			lastFrame = 0;
			tokens.forEach((token) => { token.collected = false; });
			bugs[0].x = 242;
			bugs[0].direction = 1;
			bugs[1].x = 648;
			bugs[1].direction = -1;
			resetPlayer(false);
			startScreen.hidden = false;
			winScreen.hidden = true;
			if (messageDisplay) messageDisplay.textContent = 'Press Start game when you are ready.';
			updateHud();
			draw();
		};

		const startGame = () => {
			if (!isOpen) return;
			started = true;
			won = false;
			startScreen.hidden = true;
			winScreen.hidden = true;
			lastFrame = 0;
			if (messageDisplay) messageDisplay.textContent = 'Deployment in progress.';
			canvas.focus({ preventScroll: true });
			startLoop();
		};

		const restartGame = () => {
			resetGame();
			startGame();
		};

		const finishGame = () => {
			won = true;
			cancelAnimationFrame(animationFrame);
			animationFrame = 0;
			clearInput();
			if (finalTimeDisplay) finalTimeDisplay.textContent = formatTime(elapsed);
			if (messageDisplay) messageDisplay.textContent = `Deployment complete in ${formatTime(elapsed)}.`;
			winScreen.hidden = false;
			root.querySelector<HTMLButtonElement>('[data-win-restart]')?.focus({ preventScroll: true });
			draw();
		};

		const update = (delta: number) => {
			elapsed += delta;
			respawnGlow = Math.max(0, respawnGlow - delta);

			const moveDirection = Number(input.right) - Number(input.left);
			player.vx = moveDirection * 220;
			if (input.jumpQueued && player.grounded) {
				player.vy = -520;
				player.grounded = false;
			}
			input.jumpQueued = false;

			const previousY = player.y;
			player.x += player.vx * delta;
			player.x = Math.max(0, Math.min(WIDTH - player.w, player.x));
			player.vy += 1420 * delta;
			player.y += player.vy * delta;
			player.grounded = false;

			for (const platform of platforms) {
				const previousBottom = previousY + player.h;
				const currentBottom = player.y + player.h;
				const overlapsX = player.x + player.w > platform.x && player.x < platform.x + platform.w;
				if (player.vy >= 0 && overlapsX && previousBottom <= platform.y && currentBottom >= platform.y) {
					player.y = platform.y - player.h;
					player.vy = 0;
					player.grounded = true;
				}
			}

			for (const bug of bugs) {
				bug.x += bug.speed * bug.direction * delta;
				if (bug.x <= bug.minX || bug.x >= bug.maxX) {
					bug.x = Math.max(bug.minX, Math.min(bug.maxX, bug.x));
					bug.direction *= -1;
				}
				if (intersects(player, bug)) {
					resetPlayer();
					return;
				}
			}

			for (const token of tokens) {
				if (!token.collected && intersects(player, token)) {
					token.collected = true;
					const count = collectedCount();
					if (messageDisplay) messageDisplay.textContent = count === TOTAL_TOKENS ? 'All tokens collected. Terminal unlocked!' : `${token.label} collected. ${TOTAL_TOKENS - count} remaining.`;
				}
			}

			if (collectedCount() === TOTAL_TOKENS && intersects(player, terminal)) finishGame();
			if (player.y > HEIGHT + 80) resetPlayer();
			updateHud();
		};

		const drawPixelText = (text: string, x: number, y: number, color: string, size = 13, align: CanvasTextAlign = 'left') => {
			context.font = `700 ${size}px "Courier New", monospace`;
			context.textAlign = align;
			context.textBaseline = 'middle';
			context.fillStyle = color;
			context.fillText(text, Math.round(x), Math.round(y));
		};

		const drawBackground = () => {
			const sky = context.createLinearGradient(0, 0, 0, HEIGHT);
			sky.addColorStop(0, '#06101e');
			sky.addColorStop(1, '#102a40');
			context.fillStyle = sky;
			context.fillRect(0, 0, WIDTH, HEIGHT);

			context.fillStyle = '#a8e7ff';
			const stars = [[56, 62], [125, 116], [205, 47], [286, 92], [365, 50], [447, 112], [534, 59], [625, 103], [714, 46], [802, 89], [910, 54]];
			for (const [index, star] of stars.entries()) {
				const flicker = reducedMotion.matches ? 1 : 0.55 + Math.sin(elapsed * 2 + index) * 0.35;
				context.globalAlpha = flicker;
				context.fillRect(star[0], star[1], index % 3 === 0 ? 3 : 2, index % 3 === 0 ? 3 : 2);
			}
			context.globalAlpha = 1;

			context.fillStyle = '#d9f4ff';
			context.fillRect(778, 54, 45, 9);
			context.fillRect(769, 63, 54, 36);
			context.fillStyle = '#06101e';
			context.fillRect(769, 54, 25, 36);

			const buildings = [
				{ x: 0, y: 235, w: 112, h: 210 }, { x: 118, y: 284, w: 85, h: 161 },
				{ x: 688, y: 245, w: 93, h: 200 }, { x: 788, y: 205, w: 73, h: 240 }, { x: 868, y: 267, w: 92, h: 178 },
			];
			for (const building of buildings) {
				context.fillStyle = '#081725';
				context.fillRect(building.x, building.y, building.w, building.h);
				context.fillStyle = '#17415a';
				for (let x = building.x + 13; x < building.x + building.w - 8; x += 22) {
					for (let y = building.y + 17; y < building.y + building.h - 10; y += 27) {
						if ((x + y) % 3 > 0) context.fillRect(x, y, 7, 10);
					}
				}
			}

			context.strokeStyle = '#173c55';
			context.lineWidth = 2;
			context.setLineDash([8, 10]);
			context.beginPath();
			context.moveTo(185, 492);
			context.lineTo(865, 492);
			context.stroke();
			context.setLineDash([]);
		};

		const drawPlatforms = () => {
			for (const platform of platforms) {
				context.fillStyle = platform.accent ? '#173d55' : '#0a1b2a';
				context.fillRect(platform.x, platform.y, platform.w, platform.h);
				context.fillStyle = platform.accent ? '#42a9ff' : '#24536e';
				context.fillRect(platform.x, platform.y, platform.w, 4);
				context.fillStyle = '#0c2639';
				for (let x = platform.x + 9; x < platform.x + platform.w - 4; x += 18) context.fillRect(x, platform.y + 9, 9, 3);
			}

			context.fillStyle = '#091826';
			context.fillRect(18, 425, 112, 67);
			context.fillStyle = '#15374d';
			context.fillRect(27, 435, 94, 39);
			context.fillStyle = '#72d9ff';
			context.fillRect(35, 443, 46, 4);
			context.fillStyle = '#5cf0b5';
			context.fillRect(35, 454, 68, 4);
			context.fillStyle = '#ffd166';
			context.fillRect(35, 465, 36, 4);
		};

		const drawTokens = () => {
			for (const token of tokens) {
				if (token.collected) continue;
				const bob = reducedMotion.matches ? 0 : Math.round(Math.sin(elapsed * 4 + token.x) * 3);
				context.fillStyle = '#06101e';
				context.fillRect(token.x - 3, token.y + bob - 3, token.w + 6, token.h + 6);
				context.fillStyle = token.color;
				context.fillRect(token.x, token.y + bob, token.w, token.h);
				context.fillStyle = '#0a1929';
				context.fillRect(token.x + 3, token.y + bob + 3, token.w - 6, token.h - 6);
				drawPixelText(token.label, token.x + token.w / 2, token.y + bob + token.h / 2 + 1, token.color, 11, 'center');
			}
		};

		const drawBugs = () => {
			for (const bug of bugs) {
				const x = Math.round(bug.x);
				const y = Math.round(bug.y);
				context.fillStyle = '#ff5d73';
				context.fillRect(x + 4, y + 3, 16, 12);
				context.fillRect(x + 8, y, 8, 3);
				context.fillRect(x, y + 6, 4, 3);
				context.fillRect(x + 20, y + 6, 4, 3);
				context.fillRect(x + 2, y + 14, 5, 3);
				context.fillRect(x + 17, y + 14, 5, 3);
				context.fillStyle = '#07121f';
				context.fillRect(x + 7, y + 6, 3, 3);
				context.fillRect(x + 14, y + 6, 3, 3);
			}
		};

		const drawTerminal = () => {
			const unlocked = collectedCount() === TOTAL_TOKENS;
			context.fillStyle = '#07121f';
			context.fillRect(terminal.x, terminal.y, terminal.w, terminal.h);
			context.fillStyle = unlocked ? '#5cf0b5' : '#315369';
			context.fillRect(terminal.x + 4, terminal.y + 4, terminal.w - 8, terminal.h - 8);
			context.fillStyle = '#0b2030';
			context.fillRect(terminal.x + 9, terminal.y + 10, terminal.w - 18, 29);
			if (unlocked) {
				context.globalAlpha = reducedMotion.matches ? 0.18 : 0.15 + Math.sin(elapsed * 5) * 0.08;
				context.fillStyle = '#5cf0b5';
				context.fillRect(terminal.x - 10, terminal.y - 10, terminal.w + 20, terminal.h + 20);
				context.globalAlpha = 1;
				context.fillStyle = '#5cf0b5';
				context.fillRect(terminal.x + 14, terminal.y + 20, 9, 3);
				context.fillRect(terminal.x + 23, terminal.y + 23, 7, 3);
			} else {
				drawPixelText('×', terminal.x + terminal.w / 2, terminal.y + 24, '#7892a3', 18, 'center');
			}
			context.fillStyle = unlocked ? '#5cf0b5' : '#ffcf5c';
			context.fillRect(terminal.x + 20, terminal.y + 48, 8, 4);
		};

		const drawPlayer = () => {
			const x = Math.round(player.x);
			const y = Math.round(player.y);
			if (respawnGlow > 0) {
				context.globalAlpha = 0.22;
				context.fillStyle = '#72d9ff';
				context.fillRect(x - 8, y - 8, player.w + 16, player.h + 16);
				context.globalAlpha = 1;
			}
			context.fillStyle = '#72d9ff';
			context.fillRect(x + 4, y, 14, 6);
			context.fillRect(x + 1, y + 6, 20, 13);
			context.fillStyle = '#f3c7a2';
			context.fillRect(x + 5, y + 7, 12, 9);
			context.fillStyle = '#0b2133';
			context.fillRect(x + 4, y + 19, 15, 13);
			context.fillStyle = '#42a9ff';
			context.fillRect(x, y + 20, 5, 12);
			context.fillRect(x + 18, y + 20, 4, 12);
			context.fillStyle = '#a7bfd0';
			context.fillRect(x + 4, y + 32, 6, 8);
			context.fillRect(x + 14, y + 32, 6, 8);
			context.fillStyle = '#06101e';
			context.fillRect(x + 13, y + 9, 3, 3);
		};

		const draw = () => {
			context.imageSmoothingEnabled = false;
			context.clearRect(0, 0, WIDTH, HEIGHT);
			drawBackground();
			drawPlatforms();
			drawTokens();
			drawBugs();
			drawTerminal();
			drawPlayer();
			context.fillStyle = 'rgba(4, 13, 22, .55)';
			context.fillRect(0, 0, WIDTH, 28);
			drawPixelText('NIGHT SHIFT // BUILD 01', 14, 15, '#72d9ff', 11);
		};

		const frame = (timestamp: number) => {
			if (!isOpen || !started || won || document.hidden) {
				animationFrame = 0;
				return;
			}
			if (!lastFrame) lastFrame = timestamp;
			const delta = Math.min((timestamp - lastFrame) / 1000, 1 / 30);
			lastFrame = timestamp;
			update(delta);
			draw();
			if (!won) animationFrame = requestAnimationFrame(frame);
		};

		const startLoop = () => {
			if (animationFrame || !isOpen || !started || won || document.hidden) return;
			lastFrame = 0;
			animationFrame = requestAnimationFrame(frame);
		};

		const closeGame = () => {
			if (!isOpen) return;
			cancelAnimationFrame(animationFrame);
			animationFrame = 0;
			started = false;
			isOpen = false;
			clearInput();
			host.classList.remove('is-game-open');
			heroContent.inert = false;
			heroContent.setAttribute('aria-hidden', 'false');
			gameView.inert = true;
			gameView.setAttribute('aria-hidden', 'true');
			openButton.setAttribute('aria-expanded', 'false');
			openButton.focus({ preventScroll: true });
		};

		const setKeyboardInput = (event: KeyboardEvent, pressed: boolean) => {
			if (!isOpen || !started || won) return;
			const key = event.code;
			if (!['KeyA', 'KeyD', 'KeyW', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'Space'].includes(key)) return;
			event.preventDefault();
			if (key === 'KeyA' || key === 'ArrowLeft') input.left = pressed;
			if (key === 'KeyD' || key === 'ArrowRight') input.right = pressed;
			if (key === 'KeyW' || key === 'ArrowUp' || key === 'Space') {
				if (pressed && !input.jump) input.jumpQueued = true;
				input.jump = pressed;
			}
		};

		openButton.addEventListener('click', () => {
			resetGame();
			isOpen = true;
			host.classList.add('is-game-open');
			heroContent.inert = true;
			heroContent.setAttribute('aria-hidden', 'true');
			gameView.inert = false;
			gameView.setAttribute('aria-hidden', 'false');
			openButton.setAttribute('aria-expanded', 'true');
			startButton.focus({ preventScroll: true });
		});
		startButton.addEventListener('click', startGame);
		restartButtons.forEach((button) => button.addEventListener('click', restartGame));
		closeButtons.forEach((button) => button.addEventListener('click', closeGame));
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) {
				cancelAnimationFrame(animationFrame);
				animationFrame = 0;
				clearInput();
			} else {
				startLoop();
			}
		});
		window.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && isOpen) {
				event.preventDefault();
				closeGame();
				return;
			}
			setKeyboardInput(event, true);
		}, { passive: false });
		window.addEventListener('keyup', (event) => setKeyboardInput(event, false), { passive: false });
		window.addEventListener('blur', clearInput);

		root.querySelectorAll<HTMLButtonElement>('[data-control]').forEach((button) => {
			const control = button.dataset.control as 'left' | 'right' | 'jump';
			const press = (event: PointerEvent) => {
				if (!isOpen || !started || won) return;
				event.preventDefault();
				button.setPointerCapture(event.pointerId);
				if (control === 'jump') {
					if (!input.jump) input.jumpQueued = true;
					input.jump = true;
				} else input[control] = true;
				button.classList.add('is-pressed');
			};
			const release = (event: PointerEvent) => {
				if (control === 'jump') input.jump = false;
				else input[control] = false;
				button.classList.remove('is-pressed');
				if (button.hasPointerCapture(event.pointerId)) button.releasePointerCapture(event.pointerId);
			};
			button.addEventListener('pointerdown', press);
			button.addEventListener('pointerup', release);
			button.addEventListener('pointercancel', release);
			button.addEventListener('lostpointercapture', () => {
				if (control === 'jump') input.jump = false;
				else input[control] = false;
				button.classList.remove('is-pressed');
			});
		});

		canvas.tabIndex = -1;
		resetGame();
	}
</script>

