---
import { Gamepad2, Mail } from '@lucide/astro';
import { Icon } from 'astro-icon/components';
import type { Profile } from '../data/portfolio';
import MidnightDeploy from './MidnightDeploy.astro';

interface Props {
	profile: Pick<Profile, 'name' | 'heroGreeting' | 'heroDescription' | 'email' | 'linkedinUrl' | 'githubUrl'>;
}

const { profile } = Astro.props;
---

<section class="hero section-frame" id="home" data-game-host>
	<div class="hero-intro" data-hero-content>
		<div class="hero-copy">
			<p class="terminal-intro">
				{profile.heroGreeting}<span class="terminal-cursor" aria-hidden="true"></span>
			</p>
			<p class="lede">{profile.heroDescription}</p>
			<div class="profile-actions">
				<a class="resume-button" href="#experience">View resume</a>
				<a class="icon-button" href={`mailto:${profile.email}`} aria-label={`Email ${profile.name}`} title="Email">
					<Mail size={17} stroke-width="1.7" />
				</a>
				<a class="icon-button" href={profile.linkedinUrl} target="_blank" rel="noreferrer" aria-label="LinkedIn profile" title="LinkedIn">
					<Icon name="simple-icons:linkedin" size={17} />
				</a>
				<a class="icon-button" href={profile.githubUrl} target="_blank" rel="noreferrer" aria-label="GitHub profile" title="GitHub">
					<Icon name="simple-icons:github" size={18} />
				</a>
				<button
					class="midnight-trigger"
					type="button"
					aria-label="Play Midnight Deploy"
					title="Take a break"
					aria-controls="midnight-deploy-game"
					aria-expanded="false"
					data-game-open
				>
					<Gamepad2 size={19} stroke-width="1.7" aria-hidden="true" />
				</button>
			</div>
		</div>

		<div class="hero-art">
			<img
				class="hero-image"
				src="/hero-workspace.png"
				data-theme-image
				data-dark-src="/hero-workspace.png"
				data-light-src="/hero-workspace-light.png"
				width="1672"
				height="941"
				alt="Pixel art developer working at a desk beside a city window"
			/>
		</div>
	</div>

	<div class="hero-game" id="midnight-deploy-game" aria-hidden="true" inert data-game-view>
		<MidnightDeploy />
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: block;
		min-height: 650px;
		padding-top: 104px;
		padding-bottom: 92px;
		overflow: hidden;
		overflow-anchor: none;
		border-bottom: 1px solid var(--line);
		scroll-margin-top: 76px;
	}

	.hero-intro {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1.25fr;
		align-items: center;
		gap: 54px;
		width: 100%;
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		transition: opacity 0.22s ease, transform 0.22s ease, visibility 0s;
	}

	.hero-copy {
		max-width: 540px;
	}

	.terminal-intro {
		display: flex;
		align-items: center;
		margin: 0 0 24px;
		color: var(--cyan);
		font-family: 'Courier New', Courier, monospace;
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		font-weight: 700;
		letter-spacing: 1px;
	}

	.terminal-cursor {
		display: inline-block;
		width: 0.65em;
		height: 1.05em;
		margin-left: 0.25em;
		background: var(--cyan);
		animation: terminal-blink 1s steps(1, end) infinite;
	}

	@keyframes terminal-blink {
		0%,
		48% {
			opacity: 1;
		}

		49%,
		100% {
			opacity: 0;
		}
	}

	.lede {
		max-width: 445px;
		color: var(--text);
		font-size: 17px;
		line-height: 1.75;
	}

	.profile-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 28px;
	}

	.resume-button,
	.icon-button {
		display: inline-grid;
		place-items: center;
		gap: 8px;
		font-size: 13px;
		text-decoration: none;
		transition: background 0.2s, color 0.2s, border-color 0.2s;
	}

	.resume-button {
		min-height: 42px;
		padding: 0 20px;
		border-radius: 999px;
		background: var(--blue);
		color: #061525;
		font-weight: 700;
	}

	.resume-button:hover {
		background: var(--cyan);
	}

	.icon-button {
		width: 42px;
		height: 42px;
		border: 1px solid var(--line-bright);
		border-radius: 50%;
		color: var(--text);
		font-family: Arial, sans-serif;
	}

	.icon-button:hover {
		border-color: var(--cyan);
		background: color-mix(in srgb, var(--blue) 12%, transparent);
		color: var(--cyan);
	}

	.icon-button :global(svg),
	.resume-button :global(svg) {
		flex: 0 0 auto;
	}

	:global(:root[data-theme='light']) .resume-button {
		background: #087ec6;
		color: #fff;
	}

	:global(:root[data-theme='light']) .resume-button:hover {
		background: #076da9;
	}

	.hero-art {
		justify-self: end;
		width: 100%;
		max-width: 650px;
		overflow: hidden;
	}

	.hero-image {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1672 / 941;
		object-fit: contain;
	}

	.hero-game {
		position: absolute;
		top: 104px;
		right: 34px;
		left: 34px;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(14px);
		transition: opacity 0.22s ease, transform 0.22s ease, visibility 0s 0.22s;
	}

	.hero.is-game-open .hero-intro {
		position: absolute;
		top: 104px;
		right: 34px;
		left: 34px;
		width: auto;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(-14px);
		transition: opacity 0.22s ease, transform 0.22s ease, visibility 0s 0.22s;
	}

	.hero.is-game-open .hero-game {
		position: relative;
		top: auto;
		right: auto;
		left: auto;
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateY(0);
		transition-delay: 0s;
	}

	.midnight-trigger {
		display: inline-grid;
		place-items: center;
		width: 42px;
		height: 42px;
		padding: 0;
		border: 1px solid var(--line-bright);
		border-radius: 50%;
		background: transparent;
		color: var(--text);
		cursor: pointer;
		transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
	}

	.midnight-trigger:hover {
		border-color: var(--cyan);
		background: color-mix(in srgb, var(--blue) 12%, transparent);
		color: var(--cyan);
		transform: translateY(-2px);
	}

	@media (max-width: 800px) {
		.hero {
			min-height: 0;
			padding-top: 76px;
			padding-bottom: 68px;
		}

		.hero-intro {
			grid-template-columns: 1fr;
			gap: 46px;
		}

		.hero-art {
			justify-self: stretch;
			max-width: none;
		}

		.lede {
			font-size: 16px;
		}

		.hero-game,
		.hero.is-game-open .hero-intro {
			top: 76px;
			right: 20px;
			left: 20px;
		}
	}

	@media (max-width: 500px) {
		.hero {
			padding-top: 60px;
			padding-bottom: 54px;
		}

		.hero-intro {
			gap: 35px;
		}

		.hero-art {
			height: 235px;
		}

		.profile-actions {
			gap: 9px;
		}

		.resume-button {
			padding-inline: 14px;
		}

		.hero-game,
		.hero.is-game-open .hero-intro {
			top: 60px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.terminal-cursor {
			animation: none;
		}

		.hero-intro,
		.hero-game,
		.hero.is-game-open .hero-intro,
		.hero.is-game-open .hero-game,
		.midnight-trigger {
			transition: none;
		}

		.hero-intro,
		.hero-game,
		.hero.is-game-open .hero-intro,
		.hero.is-game-open .hero-game,
		.midnight-trigger:hover {
			transform: none;
		}
	}
</style>
