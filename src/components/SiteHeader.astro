---
import { Menu, Moon, Sun } from '@lucide/astro';
import type { NavItem, Profile } from '../data/portfolio';

interface Props {
	profile: Pick<Profile, 'name' | 'initials' | 'headerNote'>;
	navigation: readonly NavItem[];
}

const { profile, navigation } = Astro.props;
---

<header class="site-header section-frame" data-site-header>
	<a class="brand" href="#home" aria-label={`${profile.name} home`}>
		<span class="brand-mark">{profile.initials}</span>
		<span>{profile.name}</span>
	</a>

	<nav class="primary-nav" aria-label="Primary navigation">
		{
			navigation.map((item, index) => (
				<a class:list={{ active: index === 0 }} href={item.href} aria-current={index === 0 ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>

	<div class="header-tools">
		<button class="menu-toggle" type="button" aria-label="Open navigation" title="Open navigation" aria-expanded="false">
			<Menu size={20} stroke-width="1.6" />
		</button>
		<button class="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch theme">
			<Moon class="theme-icon moon-icon" size={18} stroke-width="1.7" />
			<Sun class="theme-icon sun-icon" size={18} stroke-width="1.7" />
		</button>
		<span class="header-note">{profile.headerNote[0]}<br />{profile.headerNote[1]}</span>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-site-header]');

	if (header && header.dataset.ready !== 'true') {
		header.dataset.ready = 'true';

		const THEME_STORAGE_KEY = 'chanales-theme';
		const themeToggle = header.querySelector<HTMLButtonElement>('.theme-toggle');
		const menuToggle = header.querySelector<HTMLButtonElement>('.menu-toggle');
		const primaryNav = header.querySelector<HTMLElement>('.primary-nav');
		const navLinks = [...header.querySelectorAll<HTMLAnchorElement>('.primary-nav a')];
		const sections = navLinks
			.map((link) => document.querySelector(link.hash))
			.filter((section): section is HTMLElement => section instanceof HTMLElement);

		const updateHeroImage = (theme: string) => {
			const heroImage = document.querySelector<HTMLImageElement>('[data-theme-image]');
			if (!heroImage) return;

			const source = theme === 'light' ? heroImage.dataset.lightSrc : heroImage.dataset.darkSrc;
			if (source) heroImage.src = source;
		};

		const applyTheme = (theme: 'dark' | 'light') => {
			document.documentElement.dataset.theme = theme;
			themeToggle?.setAttribute('aria-label', theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
			updateHeroImage(theme);
		};

		const currentTheme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
		applyTheme(currentTheme);

		themeToggle?.addEventListener('click', () => {
			const nextTheme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
			applyTheme(nextTheme);
			try {
				localStorage.setItem(THEME_STORAGE_KEY, nextTheme);
			} catch {
				// The selected theme still applies for this page when storage is unavailable.
			}
		});

		menuToggle?.addEventListener('click', () => {
			const isOpen = document.body.classList.toggle('nav-open');
			menuToggle.setAttribute('aria-expanded', String(isOpen));
			menuToggle.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
		});

		const setActiveNav = (id: string) => {
			for (const link of navLinks) {
				const isActive = link.hash === `#${id}`;
				link.classList.toggle('active', isActive);
				if (isActive) link.setAttribute('aria-current', 'page');
				else link.removeAttribute('aria-current');
			}
		};

		primaryNav?.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				setActiveNav(link.getAttribute('href')?.slice(1) ?? 'home');
				document.body.classList.remove('nav-open');
				menuToggle?.setAttribute('aria-expanded', 'false');
				menuToggle?.setAttribute('aria-label', 'Open navigation');
			});
		});

		const sectionObserver = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) setActiveNav(entry.target.id);
				}
			},
			{ rootMargin: '-35% 0px -55% 0px', threshold: 0 },
		);

		sections.forEach((section) => sectionObserver.observe(section));
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 76px;
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(12px);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 14px;
		font-size: 16px;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 30px;
		height: 27px;
		color: var(--cyan);
		border: 1px solid var(--cyan);
		font-size: 12px;
	}

	.primary-nav {
		display: flex;
		gap: 25px;
		margin-right: 32px;
		margin-left: auto;
	}

	.primary-nav a,
	.header-note {
		color: var(--muted);
		font-size: 13px;
		text-decoration: none;
	}

	.primary-nav a:hover,
	.primary-nav a.active {
		color: var(--cyan);
	}

	.primary-nav a.active {
		padding-bottom: 8px;
		border-bottom: 1px solid var(--blue);
	}

	.header-tools {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.menu-toggle,
	.theme-toggle {
		width: 38px;
		height: 38px;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--line);
		background: var(--surface);
		color: var(--cyan);
		cursor: pointer;
	}

	.menu-toggle {
		display: none;
	}

	.theme-toggle {
		display: inline-flex;
		font-size: 17px;
	}

	.theme-icon {
		display: block;
	}

	.sun-icon {
		display: none;
	}

	:global(:root[data-theme='light']) .moon-icon {
		display: none;
	}

	:global(:root[data-theme='light']) .sun-icon {
		display: block;
	}

	.header-note {
		padding-left: 20px;
		border-left: 1px solid var(--line);
		line-height: 1.35;
	}

	:global(:root[data-theme='light']) .brand > span:last-child {
		color: #17384b;
	}

	@media (max-width: 800px) {
		.site-header {
			flex-wrap: wrap;
			gap: 16px;
			padding-block: 14px;
		}

		.brand {
			flex: 1;
			min-width: 0;
		}

		.brand > span:last-child {
			min-width: 0;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.brand-mark,
		.header-tools {
			flex: 0 0 auto;
		}

		.header-tools {
			margin-left: auto;
		}

		.header-note {
			display: none;
		}

		.menu-toggle {
			display: inline-flex;
		}

		.primary-nav {
			display: none;
		}

		:global(body.nav-open) .primary-nav {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			order: 3;
			width: 100%;
			margin: 0;
			padding: 12px 0 4px;
			gap: 0;
		}

		:global(body.nav-open) .primary-nav a {
			padding: 11px 0;
			border-bottom: 1px solid var(--line);
		}

		.primary-nav a,
		.header-note {
			font-size: 12px;
		}
	}
</style>
