---
interface Props {
	label: string;
}

const { label } = Astro.props;
---

<p class="eyebrow">{label}</p>

<style>
	.eyebrow {
		margin: 0 0 13px;
		color: var(--cyan);
		font-family: 'Courier New', Courier, monospace;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	.eyebrow::before {
		content: '';
		display: inline-block;
		width: 7px;
		height: 7px;
		margin-right: 10px;
		background: var(--blue);
	}

</style>
