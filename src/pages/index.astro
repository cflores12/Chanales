---
import Layout from '../layouts/Layout.astro';
import { Mail, Menu, Moon, Sun } from '@lucide/astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import aboutPortrait from '../assets/about-portrait.jpg';

type ExperienceItem = {
	date: string;
	role: string;
	company: string;
	highlights: string[];
};

const experience: ExperienceItem[] = [
	{
		date: 'April 2025 – Present',
		role: 'Software Development Engineer 2',
		company: "Spencer's & Spirit",
		highlights: [
			'Architected and launched a cloud-native supply-ordering application and supporting REST APIs to process and route fixture, signage, and supply requests across more than 1,500 retail locations.',
			'Built a pipeline that synchronized shipment and container data across store-opening workflows, reducing data latency by 80% and generating more than $300K in annual savings.',
			'Redesigned an Azure-hosted compliance and audit application and led its migration from Razor and JavaScript to Blazor, reducing technical debt by 60% and increasing development velocity by 40%.',
			'Led root-cause analysis and remediation for two major production incidents affecting more than 1,000 users, restoring mileage processing and authentication access while implementing long-term preventive fixes.'
		]
	},
	{
		date: 'November 2022 – March 2025',
		role: 'Software Development Engineer 1',
		company: "Spencer's & Spirit",
		highlights: [
			'Modernized a legacy inventory pipeline connecting multiple warehouse systems with the order-management platform, improving reliability during warehouse transitions.',
			'Built a scheduled synchronization service that coordinated vendor and internal scheduling across more than 1,500 locations, improving operational visibility, reducing manual coordination, and saving more than $100K annually.'
		]
	},
	{
		date: 'January 2022 – May 2022',
		role: 'Software Development Engineer Intern',
		company: "Spencer's & Spirit",
		highlights: [
			'Built and deployed an internal web application that streamlined e-commerce workflows and improved daily operational efficiency.'
		]
	},
	{
		date: 'June 2021 – August 2021',
		role: 'Software Engineer Intern',
		company: 'UPS',
		highlights: [
			'Built a proof of concept for adding alerting capabilities to a web application that tracked UPS Premier healthcare packages across scanning and sensor systems.',
			'Created Power BI reports that helped corporate users analyze healthcare package data and gain greater operational insight.',
			'Won the Crowd Favorite award at the UPS Summer Hackathon.'
		]
	},
	{
		date: 'January 2021 – May 2021',
		role: 'Software Engineer Intern',
		company: 'Viocare',
		highlights: [
			'Designed relational databases and migration processes to integrate USDA nutrition data into dietary research applications.',
			'Helped decompose a monolithic application into microservices for food data, nutrition analysis, and dietary scoring, improving scalability.',
			'Developed REST APIs that delivered nutrition analyses, dietary scores, and reports used to provide users with dietary feedback.'
		]
	},
	{
		date: 'September 2020 – December 2020',
		role: 'Software Engineer Intern',
		company: 'KAR Global (now OPENLANE)',
		highlights: [
			'Contributed to a web application supporting vehicle-shipping operations.',
			'Led the implementation of Playwright end-to-end test automation, improving application reliability and streamlining quality assurance.',
			'Helped modernize legacy Razor Pages by migrating front-end functionality to React.js.'
		]
	},
];

const techStack = ['C#', 'Blazor', '.NET MAUI', 'JavaScript', 'React', 'Playwright', 'Python', 'SQL'];

---

<Layout>
	<div class="site-shell">
		<header class="site-header">
			<a class="brand" href="#home" aria-label="Chanales Flores home"><span class="brand-mark">CF</span><span>Chanales Flores</span></a>
			<nav class="primary-nav" aria-label="Primary navigation"><a class="active" href="#home">01. Home</a><a href="#about">02. About</a><a href="#experience">03. Experience</a></nav>
			<div class="header-tools"><button class="menu-toggle" type="button" aria-label="Open navigation" title="Open navigation" aria-expanded="false"><Menu size={20} stroke-width="1.6" /></button><button class="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch theme"><Moon class="theme-icon moon-icon" size={18} stroke-width="1.7" /><Sun class="theme-icon sun-icon" size={18} stroke-width="1.7" /></button><span class="header-note">Building a better web<br />one commit at a time.</span></div>
		</header>

		<main>
			<section class="hero section-frame" id="home"><div class="hero-copy"><p class="terminal-intro">Hey, Chanales here.<span class="terminal-cursor" aria-hidden="true"></span></p><p class="lede">Software Engineer by day, curious builder by night. Based in New Jersey, I work on web applications for retail operations while spending my free time exploring different interests, experimenting with new technology, blogging, making art, and building small projects just to see where an idea can go.</p><div class="profile-actions"><a class="resume-button" href="#experience">View resume</a><a class="icon-button" href="mailto:florescareers28@gmail.com" aria-label="Email Chanales Flores" title="Email"><Mail size={17} stroke-width="1.7" /></a><a class="icon-button" href="https://www.linkedin.com/in/chanales-flores/" target="_blank" rel="noreferrer" aria-label="LinkedIn profile" title="LinkedIn"><Icon name="simple-icons:linkedin" size={17} /></a><a class="icon-button" href="https://github.com/cflores12" target="_blank" rel="noreferrer" aria-label="GitHub profile" title="GitHub"><Icon name="simple-icons:github" size={18} /></a></div></div><div class="hero-art"><img class="hero-image" src="/hero-workspace.png" data-dark-src="/hero-workspace.png" data-light-src="/hero-workspace-light.png" width="1672" height="941" alt="Pixel art developer working at a desk beside a city window" /></div></section>

			<section class="about-section section-frame" id="about"><div class="about-copy"><p class="eyebrow">02. About</p><p>At Spencer’s &amp; Spirit, I build and maintain internal applications that help support retail operations across our stores. One of my recent projects was a web application for ordering supplies across more than 1,500 Spirit Halloween locations, used daily by over 600 field managers.</p><p>More recently, I’ve also been exploring AI integrations that use data from our internal applications to improve workflows, surface useful insights, and make retail operations more efficient.</p><div class="about-toolkit"><h2>Core toolkit</h2><ul>{techStack.map((technology) => <li>{technology}</li>)}</ul></div></div><div class="about-portrait-panel"><div class="about-portrait-frame"><Image class="about-portrait" src={aboutPortrait} alt="Chanales Flores standing in Akihabara, Tokyo" layout="constrained" loading="lazy" decoding="async" /></div></div></section>

			<section class="section-frame experience-section" id="experience"><p class="eyebrow">03. Experience</p><div class="timeline">{experience.map((item) => <article class="timeline-item"><div><h3>{item.role} <span class="at-company">@ {item.company}</span></h3><time>{item.date}</time><ul class="job-highlights">{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul></div></article>)}</div></section>

		</main>

		<footer><div><strong>Chanales Flores</strong><small>Software Development Engineer 2</small></div><div class="footer-nav"><a href="#home">Home</a><a href="#about">About</a><a href="#experience">Experience</a></div><small>Built with curiosity.<br />© 2025 Chanales Flores. All rights reserved.</small></footer>

	</div>
</Layout>

<script>
	const toggle = document.querySelector('.theme-toggle');
	const menuToggle = document.querySelector('.menu-toggle');
	const primaryNav = document.querySelector('.primary-nav');
	const heroImage = document.querySelector('.hero-image');
	const navLinks = [...document.querySelectorAll('.primary-nav a')];
	const sections = navLinks.map((link) => document.querySelector(link.getAttribute('href') ?? '')).filter((section) => section instanceof HTMLElement);
	const savedTheme = localStorage.getItem('alex-theme');
	if (savedTheme) document.body.dataset.theme = savedTheme;
	const updateHeroImage = () => { if (heroImage instanceof HTMLImageElement) heroImage.src = heroImage.dataset[document.body.dataset.theme === 'light' ? 'lightSrc' : 'darkSrc'] ?? heroImage.src; };
	updateHeroImage();
	const updateThemeButton = () => toggle?.setAttribute('aria-label', document.body.dataset.theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
	updateThemeButton();
	toggle?.addEventListener('click', () => { const nextTheme = document.body.dataset.theme === 'light' ? 'dark' : 'light'; document.body.dataset.theme = nextTheme; localStorage.setItem('alex-theme', nextTheme); updateHeroImage(); updateThemeButton(); });
	menuToggle?.addEventListener('click', () => { const isOpen = document.body.classList.toggle('nav-open'); menuToggle.setAttribute('aria-expanded', String(isOpen)); menuToggle.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation'); });
	const setActiveNav = (id: string) => navLinks.forEach((link) => link.classList.toggle('active', link.getAttribute('href') === `#${id}`));
	primaryNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { setActiveNav(link.getAttribute('href')?.slice(1) ?? 'home'); document.body.classList.remove('nav-open'); menuToggle?.setAttribute('aria-expanded', 'false'); }));
	const sectionObserver = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) setActiveNav(entry.target.id); }), { rootMargin: '-35% 0px -55% 0px', threshold: 0 });
	sections.forEach((section) => sectionObserver.observe(section));
</script>

<style>
	:global(:root) { --bg: #07121f; --surface: #0a1929; --surface-soft: #0d2032; --line: #214764; --line-bright: #3b759b; --text: #edf5ff; --muted: #a5bdd0; --blue: #42a9ff; --cyan: #72d9ff; --job-title: #edf5ff; }
	:global(body[data-theme='light']) { --bg: #e8f0f3; --surface: #f5f9f9; --surface-soft: #d9ebef; --line: #9bbbc7; --line-bright: #4c899d; --text: #102b3d; --muted: #3f5b6b; --blue: #087ec6; --cyan: #087e9f; --job-title: #17384b; }
	:global(body) { background: var(--bg); transition: background .25s, color .25s; } .site-shell { overflow-x: clip; background: radial-gradient(circle at 80% 10%, color-mix(in srgb, var(--blue) 7%, transparent), transparent 28rem), repeating-linear-gradient(0deg, transparent 0 3px, color-mix(in srgb, var(--line) 12%, transparent) 4px); }
	.site-header, .section-frame, footer { width: min(100%, 1180px); margin-inline: auto; } .site-header { position: sticky; top: 0; z-index: 10; min-height: 70px; padding: 0 34px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(12px); } .brand { display: flex; align-items: center; gap: 14px; font-size: 16px; font-weight: 700; text-decoration: none; white-space: nowrap; } .brand-mark { display: grid; place-items: center; width: 30px; height: 27px; color: var(--cyan); border: 1px solid var(--cyan); font-size: 12px; }
	nav { display: flex; gap: 25px; margin-left: auto; margin-right: 32px; } nav a, .header-note, .footer-nav a { color: var(--muted); font-size: 10px; text-decoration: none; } nav a:hover, nav a.active, .footer-nav a:hover { color: var(--cyan); } nav a.active { border-bottom: 1px solid var(--blue); padding-bottom: 8px; } .header-tools { display: flex; align-items: center; gap: 20px; } .theme-toggle { width: 38px; height: 38px; border: 1px solid var(--line); background: var(--surface); color: var(--cyan); cursor: pointer; font-size: 17px; } .header-note { border-left: 1px solid var(--line); padding-left: 20px; line-height: 1.35; font-size: 9px; }
	.hero { min-height: 390px; padding: 48px 34px 26px; display: grid; grid-template-columns: 1fr 1.25fr; align-items: center; border-bottom: 1px solid var(--line); } .hero-copy { max-width: 500px; } .eyebrow { margin: 0 0 13px; color: var(--cyan); font-size: 10px; letter-spacing: 3px; text-transform: uppercase; } .eyebrow::before { content: ''; display: inline-block; width: 7px; height: 7px; margin-right: 10px; background: var(--blue); } h1 { margin: 0; color: var(--text); font-family: Georgia, serif; font-size: clamp(3.1rem, 6vw, 5.2rem); line-height: .95; letter-spacing: 1px; } h1 span { color: var(--blue); } h2 { margin: 7px 0 14px; color: var(--text); font-family: Georgia, serif; font-size: 22px; } .lede { max-width: 445px; color: var(--muted); font-size: 13px; line-height: 1.65; } .hero-actions { display: flex; gap: 13px; margin-top: 23px; } .button { display: inline-flex; align-items: center; gap: 8px; padding: 11px 17px; border: 1px solid var(--blue); color: var(--text); font-size: 11px; text-decoration: none; } .button:hover { background: color-mix(in srgb, var(--blue) 16%, transparent); } .button.primary { background: var(--blue); color: #061525; font-weight: 700; } .button span { font-size: 16px; }
	.hero-art { max-width: 590px; justify-self: end; width: 100%; overflow: hidden; } .hero-art .hero-image { display: block; width: 100%; height: auto; aspect-ratio: 1672 / 941; object-fit: contain; }
	.projects-section, .experience-section { padding: 26px 34px 30px; border-bottom: 1px solid var(--line); } .section-heading { display: flex; align-items: center; justify-content: space-between; } .section-heading a { color: var(--cyan); font-size: 10px; text-decoration: none; } .project-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 17px; } .project-card { border: 1px solid var(--line); background: color-mix(in srgb, var(--surface) 80%, transparent); transition: transform .2s, border-color .2s; } .project-card:hover { transform: translateY(-4px); border-color: var(--blue); } .project-preview { height: 120px; margin: 10px; display: grid; place-items: center; background: linear-gradient(135deg, #203f59, #8aaec0); } .blue .project-preview { background: linear-gradient(135deg, #193c67, #345f87); } .lavender .project-preview { background: linear-gradient(135deg, #d6e0ee, #8da8be); } .preview-window { width: 77%; height: 70%; position: relative; background: #f4f6f5; color: #253647; padding: 22px 10px 5px; box-shadow: 5px 5px 0 #263b4d; font-family: Arial, sans-serif; } .preview-window span { position: absolute; top: 7px; left: 8px; width: 5px; height: 5px; background: #4ea4dc; box-shadow: 9px 0 #e1b36b, 18px 0 #88bea2; } .preview-window strong { display: block; font-size: 9px; } .preview-window small { color: #64b99e; font-size: 7px; } .project-body { padding: 3px 13px 14px; } .project-body h3 { margin: 0; font-size: 15px; } .project-body p { margin: 5px 0; color: var(--muted); font-size: 11px; line-height: 1.4; } .project-body .detail { font-size: 10px; } .tags { display: flex; flex-wrap: wrap; gap: 5px; margin: 9px 0 14px; } .tags span { padding: 4px 6px; color: var(--muted); background: var(--surface-soft); font-size: 8px; } .project-link { color: var(--cyan); font-size: 10px; text-decoration: none; }
	.timeline { max-width: 980px; margin-top: 7px; padding-left: 28px; border-left: 1px solid var(--line-bright); } .timeline-item { position: relative; padding: 0 0 54px 26px; } .timeline-item:last-child { padding-bottom: 0; } .timeline-item::before { content: ''; position: absolute; left: -33px; top: 5px; width: 9px; height: 9px; background: var(--blue); border: 3px solid var(--bg); border-radius: 50%; box-shadow: 0 0 0 1px var(--blue); } .timeline-item time { display: block; margin: 7px 0 19px; color: var(--cyan); font-size: 14px; font-weight: 700; } .timeline-item h3 { margin: 0 0 8px; color: var(--job-title); font-size: 20px; line-height: 1.25; } .timeline-item p, .job-highlights { color: var(--muted); font-size: 14px; line-height: 1.7; } .timeline-item p { margin: 0; } .job-highlights { margin: 0; padding: 0; list-style: none; } .job-highlights li { position: relative; padding-left: 22px; } .job-highlights li::before { content: ''; position: absolute; top: .65em; left: 2px; width: 7px; height: 7px; border: 1px solid var(--cyan); background: color-mix(in srgb, var(--blue) 45%, transparent); box-shadow: 3px 3px 0 color-mix(in srgb, var(--blue) 22%, transparent); } .job-highlights li + li { margin-top: 12px; } .at-company { color: var(--cyan); font-weight: 600; }
	.split-section { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--line); } .about-panel, .skills-panel { padding: 27px 34px; } .about-panel { border-right: 1px solid var(--line); } .about-panel > p { color: var(--muted); font-size: 10px; line-height: 1.55; max-width: 500px; } .note { display: flex; justify-content: space-between; margin-top: 15px; padding: 9px 11px; border: 1px solid var(--line-bright); color: var(--cyan); font-size: 9px; } .note span { color: #408c78; } .skills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; } .skills span { display: flex; align-items: center; gap: 8px; padding: 7px; border: 1px solid var(--line); color: var(--muted); font-size: 9px; } .skills b { color: var(--blue); font-family: Arial, sans-serif; font-size: 12px; }
	.split-section { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--line); } .about-panel, .skills-panel { padding: 27px 34px; } .about-panel { border-right: 1px solid var(--line); } .about-panel > p { color: var(--muted); font-size: 10px; line-height: 1.55; max-width: 500px; } .note { display: flex; justify-content: space-between; margin-top: 15px; padding: 9px 11px; border: 1px solid var(--line-bright); color: var(--cyan); font-size: 9px; } .note span { color: #408c78; } .skills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; } .skills span { display: flex; align-items: center; gap: 8px; padding: 7px; border: 1px solid var(--line); color: var(--muted); font-size: 9px; } .skills b { color: var(--blue); font-family: Arial, sans-serif; font-size: 12px; }
	.contact-section { padding: 29px 34px 34px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; } .contact-section h2 { margin: 0 0 5px; font-size: 18px; } .contact-section > div > p:not(.eyebrow) { margin: 0; color: var(--muted); font-size: 10px; line-height: 1.5; } .contact-links { display: grid; gap: 7px; align-content: center; } .contact-links a { display: grid; grid-template-columns: 25px 70px 1fr 20px; align-items: center; padding: 8px 10px; border: 1px solid var(--line); color: var(--text); text-decoration: none; font-size: 10px; } .contact-links a:hover { border-color: var(--blue); } .contact-links b { color: var(--blue); font-family: Arial, sans-serif; } .contact-links small { color: var(--cyan); font-size: 9px; } .contact-links i { color: var(--cyan); font-style: normal; text-align: right; }
	footer { padding: 20px 34px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--line); color: var(--muted); } footer strong, footer small { display: block; } footer strong { color: var(--text); font-size: 12px; } footer small { font-size: 8px; line-height: 1.5; } .footer-nav { display: flex; gap: 26px; }
	@media (max-width: 800px) { .site-header { padding: 14px 20px; flex-wrap: wrap; gap: 16px; } .site-header nav { order: 3; width: 100%; margin: 0; justify-content: space-between; gap: 8px; overflow-x: auto; } .header-note { display: none; } .hero { padding: 43px 20px 28px; grid-template-columns: 1fr; gap: 35px; } .hero-art { justify-self: stretch; max-width: none; } .projects-section, .experience-section, .about-panel, .skills-panel, .contact-section { padding-inline: 20px; } .project-grid { grid-template-columns: 1fr; } .split-section, .contact-section { grid-template-columns: 1fr; gap: 0; } .about-panel { border-right: 0; border-bottom: 1px solid var(--line); } .contact-links { margin-top: 25px; } footer { padding-inline: 20px; gap: 18px; align-items: flex-start; } .footer-nav { display: none; } }
	@media (max-width: 500px) { h1 { font-size: 3.2rem; } .hero-actions { flex-wrap: wrap; } .hero-art { height: 235px; } .timeline-item { grid-template-columns: 1fr; gap: 5px; } .contact-links a { grid-template-columns: 25px 60px 1fr 15px; } .contact-links small { overflow: hidden; text-overflow: ellipsis; } .skills { grid-template-columns: repeat(2, 1fr); } }
	@media (prefers-reduced-motion: reduce) { :global(*) { scroll-behavior: auto !important; transition-duration: .01ms !important; } .project-card:hover { transform: none; } }

	.site-header, .section-frame, footer { width: 100%; max-width: none; padding-inline: max(34px, calc((100% - 1112px) / 2)); }
	.site-header { min-height: 76px; }
	.hero { min-height: 540px; padding-top: 78px; padding-bottom: 62px; gap: 54px; }
	.hero-copy { max-width: 540px; }
	h1 { font-size: clamp(3.8rem, 7vw, 6.2rem); }
	.hero-art { max-width: 650px; }
	.profile-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
	.resume-button, .icon-button { display: inline-grid; place-items: center; text-decoration: none; transition: background .2s, color .2s, border-color .2s; }
	.resume-button { min-height: 42px; padding: 0 20px; border-radius: 999px; background: var(--blue); color: #061525; font-size: 12px; font-weight: 700; }
	.resume-button:hover { background: var(--cyan); }
	.icon-button { width: 42px; height: 42px; border: 1px solid var(--line-bright); border-radius: 50%; color: var(--text); font-family: Arial, sans-serif; font-size: 16px; }
	.icon-button:hover { border-color: var(--cyan); color: var(--cyan); background: color-mix(in srgb, var(--blue) 12%, transparent); }
	.projects-section, .experience-section { padding-top: 58px; padding-bottom: 64px; }
	.projects-section { background: color-mix(in srgb, var(--surface) 38%, transparent); }
	.experience-section { background: color-mix(in srgb, var(--bg) 72%, var(--surface)); }
	.section-heading { margin-bottom: 26px; }
	.project-grid { gap: 24px; }
	.project-preview { height: 175px; margin: 14px; }
	.project-body { padding: 9px 18px 23px; }
	.project-body h3 { font-size: 17px; }
	.project-body p { font-size: 12px; line-height: 1.55; }
	.project-body .detail { font-size: 11px; }
	.tags { margin-top: 14px; margin-bottom: 19px; }
	.timeline { margin-top: 25px; max-width: 980px; }
	.timeline-item { padding-top: 22px; padding-bottom: 22px; }
	.split-section { background: color-mix(in srgb, var(--surface) 38%, transparent); }
	.about-panel, .skills-panel { padding-top: 58px; padding-bottom: 62px; }
	.about-panel > p { font-size: 11px; line-height: 1.7; }
	.contact-section { padding-top: 64px; padding-bottom: 72px; min-height: 300px; }
	footer { padding-top: 30px; padding-bottom: 30px; }

	@media (max-width: 800px) {
		.site-header, .section-frame, footer { padding-inline: 20px; }
		.hero { min-height: 0; padding-top: 58px; padding-bottom: 48px; gap: 46px; }
		.projects-section, .experience-section { padding-top: 46px; padding-bottom: 52px; }
		.project-grid { gap: 24px; }
		.project-preview { height: 190px; }
		.about-panel, .skills-panel { padding-top: 46px; padding-bottom: 50px; }
		.contact-section { padding-top: 52px; padding-bottom: 58px; }
	}

	@media (max-width: 500px) {
		.hero { padding-top: 46px; padding-bottom: 38px; }
		h1 { font-size: 3.5rem; }
		.project-preview { height: 160px; }
		.profile-actions { gap: 9px; }
		.resume-button { padding-inline: 14px; }
	}

	nav a, .header-note, .footer-nav a { font-size: 12px; }
	.eyebrow { font-size: 12px; letter-spacing: 2px; }
	.hero h2 { font-size: 28px; }
	.terminal-intro { display: flex; align-items: center; margin: 0 0 24px; color: var(--cyan); font-family: 'Courier New', Courier, monospace; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 700; letter-spacing: 1px; }
	.terminal-cursor { display: inline-block; width: .65em; height: 1.05em; margin-left: .25em; background: var(--cyan); animation: terminal-blink 1s steps(1, end) infinite; }
	@keyframes terminal-blink { 0%, 48% { opacity: 1; } 49%, 100% { opacity: 0; } }
	.lede { font-size: 16px; line-height: 1.75; }
	.timeline-item h3 { color: var(--job-title); font-size: 18px; margin-bottom: 7px; }
	.timeline-item p { font-size: 13px; line-height: 1.65; }
	.timeline-item .company { margin-bottom: 0; }
